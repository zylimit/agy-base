{
  "security-gate": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command|write_to_file",
        "hooks": [
          {
            "type": "command",
            "command": "node harness/hook-handlers.js pre-tool-check",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "arch-audit": {
    "enabled": true,
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "node harness/hook-handlers.js post-tool-check",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "context-reminder": {
    "enabled": true,
    "PreInvocation": [
      {
        "type": "command",
        "command": "node harness/hook-handlers.js pre-invocation",
        "timeout": 10
      }
    ]
  },
  "completion-gate": {
    "enabled": true,
    "Stop": [
      {
        "type": "command",
        "command": "node harness/hook-handlers.js stop-gate",
        "timeout": 10
      }
    ]
  }
}
